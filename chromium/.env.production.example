# Copy to .env.production for Chrome Web Store / production builds.
# These are public client-side identifiers, not secrets.

# Clerk production publishable key from Clerk Dashboard → API keys → Chrome Extension.
WXT_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx

# Production Convex deployment URL.
WXT_CONVEX_URL=https://convex.bookmark.land

# Clerk production custom Frontend API origin.
WXT_CLERK_FRONTEND_API=https://clerk.bookmark.land

# Production web app origin used by Clerk sync-host.
WXT_CLERK_SYNC_HOST=https://bookmark.land

# Production web app URL used for all extension links.
WXT_WEB_APP_URL=https://bookmark.land
