# Copy to .env and fill in, for a development build. All of these end up in the
# built extension, so none of them is a secret. Never commit a filled-in copy.
# Signing in needs a Clerk instance and a bookmark.land backend that allow this
# extension's ID. See ../CONTRIBUTING.md for what works without one.

WXT_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
WXT_CONVEX_URL=https://your-deployment.convex.cloud
WXT_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
# Host the extension syncs its Clerk session from.
WXT_CLERK_SYNC_HOST=http://localhost
# Web app used for sign-in, dashboard, settings and collection note links.
WXT_WEB_APP_URL=http://localhost:3000
